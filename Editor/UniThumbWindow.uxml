<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="stt-root" class="stt-root">
        <ui:VisualElement class="stt-header">
            <ui:VisualElement class="stt-source-row">
                <ui:Label name="source-title-label" text="Active Scene" class="stt-section-header" />
                <ui:Label name="source-mode-badge" text="Scene" class="stt-mode-badge stt-mode-badge-scene" tooltip="Thumbnail source: active scene or selected prefab" />
            </ui:VisualElement>
            <ui:Label name="active-scene-label" class="stt-scene-path" tooltip="Scene captured by Generate; must be saved first" />
        </ui:VisualElement>
        <ui:VisualElement name="stt-update-banner" class="stt-update-banner stt-hidden">
            <ui:Label name="update-banner-label" text="A new version of UniThumb is available!" />
            <ui:Button name="update-banner-dismiss-button" text="Dismiss" />
        </ui:VisualElement>
        <ui:VisualElement class="stt-tab-bar">
            <ui:Button name="scene-tab-button" text="Scene Thumbnail" class="stt-tab-button" />
            <ui:Button name="settings-tab-button" text="Settings" class="stt-tab-button" />
        </ui:VisualElement>
        <ui:ScrollView name="scene-tab-scroll" class="stt-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" view-data-key="stt-scene-tab-scroll">
            <ui:VisualElement class="stt-card">
                <ui:VisualElement class="stt-card-header-row">
                    <ui:Image name="stt-icon-preview" class="stt-section-icon stt-hidden" tooltip="Thumbnail preview" />
                    <ui:Label text="Preview" class="stt-section-header" />
                </ui:VisualElement>
                <ui:VisualElement name="preview-mode-row" class="stt-preview-mode-row stt-hidden">
                    <ui:Label name="preview-mode-badge" text="Prefab" class="stt-mode-badge stt-mode-badge-prefab stt-mode-badge-centered" tooltip="Previewing the selected prefab; orbit framing always applies" />
                </ui:VisualElement>
                <ui:Label name="no-thumbnail-label" text="No thumbnail yet - press Generate Thumbnail" class="stt-empty-label" />
                <ui:VisualElement name="preview-wrap" class="stt-preview-wrap">
                    <ui:VisualElement name="preview-box" class="stt-preview-box stt-hidden">
                        <ui:Image name="preview-image" class="stt-preview-image" scale-mode="ScaleToFit" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="preview-caption-row" class="stt-caption-row stt-hidden">
                    <ui:Label name="preview-caption" class="stt-caption" />
                </ui:VisualElement>
                <ui:Slider name="particle-preview-time-slider" label="Particle Time" low-value="0" high-value="5" value="1" tooltip="Particle/VFX pre-roll time in seconds for prefab captures (preview and Generate). Prefab-only; scene captures ignore this." />
            </ui:VisualElement>
            <ui:VisualElement class="stt-card">
                <ui:VisualElement class="stt-card-header-row">
                    <ui:Image name="stt-icon-resolution" class="stt-section-icon stt-hidden" tooltip="Output image dimensions" />
                    <ui:Label text="Resolution" class="stt-section-header" />
                </ui:VisualElement>
                <ui:DropdownField name="resolution-popup" label="Resolution" tooltip="Output pixel size: 16, 32, 64, 128, 256, 512, 1024, or 2048" />
            </ui:VisualElement>
            <ui:Foldout name="framing-foldout" text="Framing" class="stt-foldout-card" value="true">
                <ui:Toggle name="orthographic-toggle" label="Orthographic (2D)" tooltip="Capture with an orthographic camera (2D games)" />
                <ui:Toggle name="sceneview-angle-toggle" label="Use current Scene View angle" tooltip="When off, orbit yaw/pitch below drive the capture camera." />
                <ui:Slider name="framing-distance-slider" label="Framing Distance" low-value="0.25" high-value="4" value="1" tooltip="Multiplier of the auto-fit framing distance; the zoom control in orthographic (2D) mode." />
                <ui:SliderInt name="orbit-fov-slider" label="Orbit FOV" low-value="30" high-value="120" value="60" tooltip="Camera field of view: narrow (30) telephoto to wide (120)" />
                <ui:Slider name="fit-factor-slider" label="Framing Tightness" low-value="0.5" high-value="4" value="2" tooltip="How tightly the thumbnail frames the scene bounds (1 = snug, higher = more padding)" />
                <ui:Label name="framing-disabled-hint" text="Disabled while using the current Scene View angle" class="stt-mini stt-hint stt-hidden" />
                <ui:VisualElement name="orbit-controls" class="stt-orbit-controls">
                    <ui:Slider name="orbit-yaw-slider" label="Orbit Yaw" low-value="-180" high-value="180" value="45" tooltip="Horizontal rotation angle (-180 to 180)" />
                    <ui:Slider name="orbit-pitch-slider" label="Orbit Pitch" low-value="-89" high-value="89" value="25" tooltip="Vertical rotation angle (-89 to 89)" />
                    <ui:VisualElement name="presets-row" class="stt-presets-row">
                        <ui:Button name="preset-front-button" text="Front" class="stt-preset-button" tooltip="Yaw -180, Pitch 0" />
                        <ui:Button name="preset-threequarter-button" text="Three-Quarter" class="stt-preset-button" tooltip="Yaw 45, Pitch 25" />
                        <ui:Button name="preset-top-button" text="Top" class="stt-preset-button" tooltip="Yaw 0, Pitch 85" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:Foldout>
            <ui:Foldout name="bgfx-foldout" text="Background &amp; Effects" class="stt-foldout-card" value="true">
                <ui:EnumField name="bg-mode-field" label="Mode" tooltip="Skybox renders RenderSettings.skybox; Solid Color clears to color; Transparent clears to fully transparent (alpha 0, HDR and post-processing off)" />
                <uie:ColorField name="bg-color-field" label="Background color" show-alpha="true" tooltip="Background color only applies in Solid Color mode" />
                <ui:Toggle name="lighting-toggle" label="Disable scene lighting" tooltip="Temporarily disables all lights during capture." />
                <ui:Toggle name="postfx-toggle" label="Post-processing (Volume effects)" tooltip="Renders URP Volume effects (tonemapping, bloom, vignette) into the thumbnail." />
                <uie:ObjectField name="postfx-profile-field" label="PP Profile" tooltip="VolumeProfile used when post-processing is on. When set, this profile always wins (even over scene Volumes). Empty: auto (scene Volume, else the first project profile with visible effects)" />
                <ui:FloatField name="hdrp-exposure-field" label="HDRP Exposure (EV)" tooltip="Fixed exposure value for HDRP capture tonemapping. Lower = darker, higher = brighter. Only applies in HDRP projects." class="stt-hidden" />
                <ui:Toggle name="capture-ui-toggle" label="Capture UI" tooltip="Renders scene and prefab canvases into the thumbnail (switches Screen Space Overlay canvases to the capture camera). On by default, so prefab UI renders; off culls UI (previous prefab output)" />
                <ui:Slider name="ui-scale-slider" label="UI Scale" low-value="0.5" high-value="3" value="1" tooltip="Scales the captured UI within the thumbnail (1 = as seen in the editor)" />
            </ui:Foldout>
            <ui:Foldout name="lighting-foldout" text="Lighting" class="stt-foldout-card" value="true">
                <ui:EnumField name="lighting-mode" label="Mode" tooltip="Lighting mode for capture" />
                <ui:Slider name="light2d-intensity" label="Intensity" low-value="0" high-value="5" value="1" tooltip="Intensity of the 2D global light" class="stt-hidden" />
                <uie:MaskField name="light2d-sorting-layers" label="Lit Layers" tooltip="Sorting layers affected by the global Light2D (all by default)" class="stt-hidden" />
                <ui:Slider name="light3d-intensity" label="Intensity" low-value="0" high-value="5" value="1" tooltip="Intensity of the directional light" class="stt-hidden" />
                <ui:Slider name="light3d-prefab-intensity" label="Prefab Intensity" low-value="0" high-value="5" value="1.75" tooltip="Intensity of the directional light for prefab captures only (explicit Light3D key and None-fallback temp light); scene captures use Intensity" class="stt-hidden" />
                <ui:Label name="light3d-prefab-intensity-max" text="Max 5.00" class="stt-mini stt-hint stt-hidden" tooltip="Maximum prefab intensity (driven by Limits Intensity Max)" />
                <ui:Toggle name="light3d-shadows" label="Cast Shadows" tooltip="Enable soft shadows on the directional light" class="stt-hidden" />
                <uie:ColorField name="light3d-color" label="Color" tooltip="Color of the directional light" class="stt-hidden" />
                <ui:Slider name="light3d-yaw" label="Yaw" low-value="-180" high-value="180" value="50" tooltip="Horizontal rotation of the directional light (-180 to 180)" class="stt-hidden" />
                <ui:Slider name="light3d-pitch" label="Pitch" low-value="-89" high-value="89" value="-30" tooltip="Vertical rotation of the directional light (-89 to 89)" class="stt-hidden" />
            </ui:Foldout>
            <ui:VisualElement class="stt-card">
                <ui:VisualElement class="stt-card-header-row">
                    <ui:Image name="stt-icon-layers" class="stt-section-icon stt-hidden" tooltip="Visible layers in capture" />
                    <ui:Label text="Layers" class="stt-section-header" />
                </ui:VisualElement>
                <uie:MaskField name="layers-mask" label="Include Layers" tooltip="Layers rendered into the thumbnail; the capture camera culling mask (Everything by default)." />
            </ui:VisualElement>
            <ui:VisualElement class="stt-card">
                <ui:VisualElement class="stt-card-header-row">
                    <ui:Image name="stt-icon-batch" class="stt-section-icon stt-hidden" tooltip="Batch folder operations" />
                    <ui:Label text="Batch" class="stt-section-header" />
                </ui:VisualElement>
                <ui:VisualElement name="batch-folder-row" class="stt-batch-folder-row">
                    <ui:TextField name="batch-folder-field" label="Batch folder" class="stt-batch-folder-field" tooltip="Project folder scanned recursively for scenes and prefabs" />
                    <ui:Button name="browse-button" text="Browse..." tooltip="Open folder picker" />
                </ui:VisualElement>
                <ui:EnumField name="batch-scope-field" label="Scope" class="stt-batch-scope-field" tooltip="Asset types included in folder batch and clear: All, ScenesOnly, or PrefabsOnly" />
                <ui:Button name="use-scene-folder-button" text="Use current scene's folder" class="stt-indented-button" tooltip="Set batch folder to current scene's directory" />
                <ui:Button name="clear-folder-button" text="Clear Folder Thumbnails" class="stt-danger-button stt-indented-button" tooltip="Deletes thumbnails of scoped assets in the batch folder (asks for confirmation)" />
                <ui:Label name="batch-invalid-label" text="Not a project folder - pick a folder inside Assets/" class="stt-mini stt-error-text stt-hidden" />
                <!-- Moved to stt-bottom-bar -->
                <ui:VisualElement name="batch-progress" class="stt-batch-progress stt-hidden">
                    <ui:ProgressBar name="batch-progress-bar" class="stt-progress-bar" />
                    <ui:Label name="batch-progress-caption" class="stt-mini stt-batch-progress-caption" />
                    <ui:Button name="cancel-batch-button" text="Cancel Batch" tooltip="Stop the current batch operation" />
                </ui:VisualElement>
                <ui:HelpBox name="batch-result-help" class="stt-result-help stt-hidden" message-type="Info" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:ScrollView name="settings-tab-scroll" class="stt-scroll stt-hidden" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" view-data-key="stt-settings-tab-scroll">
            <ui:VisualElement class="stt-card">
                <ui:VisualElement class="stt-card-header-row">
                    <ui:Image name="stt-icon-storage" class="stt-section-icon stt-hidden" tooltip="Thumbnail storage location" />
                    <ui:Label text="Storage" class="stt-section-header" />
                </ui:VisualElement>
                <ui:EnumField name="storage-mode-field" label="Storage Mode" tooltip="Where generated thumbnails are stored (Library cache or tracked inside Assets)" />
                <ui:Label name="storage-mode-hint" text="Thumbnails are stored in Library/SceneThumbnails. Machine-local and regenerable, not shared through Git." class="stt-mini stt-hint" />
            </ui:VisualElement>
            <ui:VisualElement class="stt-card">
                <ui:VisualElement class="stt-card-header-row">
                    <ui:Image name="stt-icon-tracking" class="stt-section-icon stt-hidden" tooltip="Thumbnail auto-regeneration" />
                    <ui:Label text="Tracking" class="stt-section-header" />
                </ui:VisualElement>
                <ui:Toggle name="auto-regen-toggle" label="Regenerate on Save" tooltip="Automatically regenerate scene and prefab thumbnails when they are saved. Runs only while this window is open" />
                <ui:Toggle name="update-check-toggle" label="Check for Updates" tooltip="Opt-in update check via the GitHub Releases API. When off, the Tools > UniThumb > Check for Updates menu action does nothing and no network request is made" />
                <ui:Toggle name="allow-batch-discard-toggle" label="Allow Batch Discard" tooltip="When on, batch generation may switch scenes and silently discard unsaved changes instead of refusing to start. Off by default (batches refuse while any open scene is dirty)" />
            </ui:VisualElement>
            <ui:VisualElement class="stt-card">
                <ui:VisualElement class="stt-card-header-row">
                    <ui:Image name="stt-icon-overlay" class="stt-section-icon stt-hidden" tooltip="Project window icon overlay" />
                    <ui:Label text="Icon Overlay" class="stt-section-header" />
                </ui:VisualElement>
                <ui:Toggle name="icon-overlay-toggle" label="Enable icon overlay" tooltip="Shows scene thumbnails as icons in the Project window" />
                <ui:Slider name="list-padding-x-slider" label="List Padding X (px)" low-value="0" high-value="8" value="2" tooltip="Horizontal padding around icons in one-column (list) view" />
                <ui:Slider name="list-padding-y-slider" label="List Padding Y (px)" low-value="0" high-value="8" value="2" tooltip="Vertical padding around icons in one-column (list) view" />
                <ui:Slider name="icon-max-size-slider" label="Icon Max Size (px)" low-value="16" high-value="256" value="128" tooltip="Maximum drawn size of the icon overlay in pixels. While it limits the icon, icons float centered and padding below the natural margin has no further effect" />
            </ui:VisualElement>
            <ui:VisualElement class="stt-card">
                <ui:VisualElement class="stt-card-header-row">
                    <ui:Image name="stt-icon-cache" class="stt-section-icon stt-hidden" tooltip="Thumbnail cache settings" />
                    <ui:Label text="Cache" class="stt-section-header" />
                </ui:VisualElement>
                <ui:SliderInt name="cache-size-slider" label="Cache Limit (MB)" low-value="32" high-value="2048" value="256" tooltip="Maximum editor memory (RAM) used by decoded scene thumbnails - not disk space. Generated PNG files are never deleted by this limit. When the budget is exceeded, the least recently used thumbnails are unloaded from memory and their icons reload automatically from disk the next time they are shown. Raise it to keep icons instantly available across many scenes; lower it to reduce editor memory usage." />
            </ui:VisualElement>
            <ui:VisualElement name="limits-card" class="stt-card">
                <ui:VisualElement class="stt-card-header-row">
                    <ui:Image name="stt-icon-limits" class="stt-section-icon stt-hidden" tooltip="Light intensity and angle limits" />
                    <ui:Label text="Limits" class="stt-section-header" />
                </ui:VisualElement>
                <ui:FloatField name="limits-intensity-max" label="Intensity Max" value="5" tooltip="Maximum Light3D intensity (0 exclusive to 10 inclusive). Drives the Intensity slider range." />
                <ui:FloatField name="limits-yaw-min" label="Yaw Min" value="-180" tooltip="Minimum Light3D yaw angle in degrees." />
                <ui:FloatField name="limits-yaw-max" label="Yaw Max" value="180" tooltip="Maximum Light3D yaw angle in degrees." />
                <ui:FloatField name="limits-pitch-min" label="Pitch Min" value="-89" tooltip="Minimum Light3D pitch angle in degrees." />
                <ui:FloatField name="limits-pitch-max" label="Pitch Max" value="89" tooltip="Maximum Light3D pitch angle in degrees." />
                <ui:Label name="limits-hint" text="Limits drive the Lighting slider ranges and capture clamping." class="stt-mini stt-hint stt-limits-hint" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="stt-bottom-bar">
            <ui:Button name="generate-button" text="Generate Thumbnail" class="stt-generate-button" />
            <ui:Button name="delete-thumbnail-button" text="Delete Thumbnail" class="stt-danger-button" tooltip="Deletes the thumbnail of the currently open scene" />
            <ui:Button name="generate-folder-button" text="Generate Folder Thumbnails" class="stt-generate-folder-button" tooltip="Generate thumbnails for all scenes in folder" />
            <ui:Label name="generate-busy-label" text="Generation in progress..." class="stt-mini stt-hidden" />
        </ui:VisualElement>
        <ui:HelpBox name="status-help" class="stt-status-help stt-hidden" message-type="Info" />
        <ui:Label name="footer-label" class="stt-footer" tooltip="Storage location managed by UniThumb" />
    </ui:VisualElement>
</ui:UXML>
